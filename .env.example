# ---------------------------------------------------------------------------
# Spoolio configuration. Copy this file to `.env` and edit as needed.
#
#   cp .env.example .env
#
# For Docker, you can leave SECRET_KEY / JWT_SECRET_KEY blank — the container
# generates and persists strong values automatically on first run.
# ---------------------------------------------------------------------------

# --- Core ---
# Container image used by Docker Compose. Pin a release tag for reproducible
# deployments, for example ghcr.io/markgwharry/spoolio:0.1.0.
SPOOLIO_IMAGE=ghcr.io/markgwharry/spoolio:latest

# Set to "production" to enforce strong secrets and disable debug behaviour.
FLASK_ENV=production

# Read by the Flask CLI (`flask run`) only — the gunicorn production path
# ignores it. Kept explicitly false so a stray `flask run` cannot start with
# the debugger exposed.
FLASK_DEBUG=False

# Cryptographic secrets. MUST be strong random strings (>= 32 chars) in
# production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank when using Docker to have them auto-generated on first run.
SECRET_KEY=
JWT_SECRET_KEY=
# Encrypts stored device Wi-Fi passwords independently of Flask sessions.
# Existing SECRET_KEY-encrypted values remain readable during migration.
WIFI_CREDENTIAL_KEY=

# --- Onboarding ---
# Docker defaults to first-user when this is omitted: the first browser-created
# account is a verified administrator, then public registration closes forever.
# The application default outside Docker is waitlist. Supported values:
#   first-user  one-time owner setup (recommended for self-hosting)
#   waitlist    collect interest without creating accounts (hosted default)
#   closed      disable both account creation and waitlist submissions
REGISTRATION_MODE=first-user
# Required by first-user mode. Leave blank in Docker to generate and persist a
# code automatically; retrieve it with `docker compose logs spoolio`.
REGISTRATION_TOKEN=

# --- Database ---
# Defaults to a local SQLite file under instance/ when unset.
# For Postgres:  postgresql+psycopg://user:pass@host:5432/spoolio
#
# Two variables select the database (app.py). SQLALCHEMY_DATABASE_URI is
# checked FIRST and wins if both are set; DATABASE_URL is the fallback. Set
# only one — if they ever disagree, DATABASE_URL is silently ignored.
# Note the four slashes for an absolute SQLite path (sqlite:/// + /abs/path).
# SQLALCHEMY_DATABASE_URI=
# DATABASE_URL=

# --- Web ---
# Comma-separated list of origins allowed to call the API from a browser.
# Only needed if you serve the frontend from a different origin than the API.
CORS_ORIGINS=http://localhost:8000

# Maximum HTTP request-body size in bytes. Defaults to 16 MiB. This protects
# profile-image and firmware upload endpoints from unbounded requests.
MAX_CONTENT_LENGTH=16777216

# Dormant firmware release/download endpoints. No maintained Spoolio sketch
# implements an OTA client yet, so this remains off unless you are developing
# and validating your own compatible client.
FIRMWARE_OTA_ENABLED=false

# Public port the container listens on (host side). Docker only.
SPOOLIO_PORT=8000

# Absolute path to the directory of built frontend assets (read by wsgi.py).
# Leave unset to serve ./static from the app directory, which is what Docker
# and local development do.
# SPOOLIO_STATIC_DIR=

# --- Email (optional) ---
# Leave blank to disable outbound mail. The first-user owner is verified
# automatically; password-reset and waitlist messages require working SMTP.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
# Set true for implicit TLS (usually port 465). Mutually exclusive with
# MAIL_USE_TLS, which is STARTTLS on port 587.
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Optional internal recipient for new waitlist alerts. No alert is sent when blank.
WAITLIST_NOTIFICATION_EMAIL=

# --- Gunicorn (Docker) ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
